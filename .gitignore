# ============================================================
# Git 忽略规则
# ============================================================

# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-web/
build/
*.tsbuildinfo
.turbo/
.rspeedy/

# 环境变量（含密钥，禁止提交）
.env
.env.*
!.env.example

# 运行时数据
runtime/
*.log
logs/

# Android 原生工程生成物（保留源码，忽略构建输出）
apps/client/android/.gradle/
apps/client/android/build/
apps/client/android/app/build/
apps/client/android/local.properties
apps/client/android/gradle/wrapper/gradle-wrapper.jar

# Android 签名密钥：绝不进版本库
# （本地放 android/key.properties + android/*.jks；
#   CI 上由 GitHub Secrets 还原）
*.jks
*.keystore
key.properties

# 桌面端
apps/desktop/release/
apps/desktop/out/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 安装包产物
*.apk
*.aab
*.ipa
*.hap
*.dmg
*.exe
*.msi
*.AppImage
