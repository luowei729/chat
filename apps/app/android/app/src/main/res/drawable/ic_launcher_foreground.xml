<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  应用图标前景（自适应图标顶层）—— 加大加粗的白色 "C"
  ============================================================
  几何参数：
    画布     108 × 108
    圆心     (54, 54)
    半径     21        ← 留出呼吸空间，不顶满安全区
    线宽     14        ← 中等偏粗；外缘 21 + 7 = 28（安全区 33 以内）
                         内孔半径 21 - 7 = 14，字怀清晰
                         之前用 25/16 会显得过大过厚，缩到 21/14 更接近 iOS 图标的视觉重量。
    开口朝向 右侧，开口角约 100°

  C 的字形用「圆弧 + 粗描边 + 圆头端点」画：
    这比用多段贝塞尔拼填充轮廓更可控 —— 改粗细只要改 strokeWidth，
    改大小只要改半径，不会像填充路径那样一改就变形。
  ============================================================
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      C 字形：从右上（约 -50°）逆时针经左侧画到右下（约 +50°）
        起点  (70.1, 34.9) = 圆心 + 半径×(cos(-50°), sin(-50°))
        终点  (70.1, 73.1) = 圆心 + 半径×(cos(+50°), sin(+50°))
        large-arc=1 表示走大于 180° 的大弧（约 260°）
        sweep=0     表示逆时针方向（开口朝右）
    -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="14"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M67.5,37.9 A21,21 0 1 0 67.5,70.1" />
</vector>
