<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ============================================================
      应用主题
      ------------------------------------------------------------
      用 Material.Light.NoActionBar 而不是 AppCompat 主题：
      1. 不依赖 appcompat 的 Material 组件，减小包体积；
      2. 深色界面由 Lynx 自己绘制，原生只负责黑底；
      3. 避免 AppCompat 主题在部分国产 ROM 上的兼容问题。
      ============================================================
    -->
    <style name="Theme.Chat" parent="Theme.Material.Light.NoActionBar">
        <!-- 启动瞬间的窗口背景：与前端深色背景一致，避免白屏闪一下 -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
