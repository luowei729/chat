# ============================================================
# chat 服务端环境变量示例
# ------------------------------------------------------------
# 复制为 .env 后填写真实值。所有密钥均可通过 openssl 生成：
#   JWT_SECRET:              openssl rand -hex 32
#   TURN_STATIC_AUTH_SECRET: openssl rand -hex 32
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=https://chat.lkz.pub

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chat2
DB_PASSWORD=
DB_NAME=chat2
DB_POOL_SIZE=10

# ---------- JWT ----------
JWT_SECRET=
JWT_ISSUER=chat.lkz.pub

# ---------- 邮件 ----------
# Zoho / QQ / 163 均需使用「应用专用密码」
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=chat
SMTP_FROM=
# 开发环境把验证码打到日志（生产必须 false）
SMTP_DEV_FALLBACK=true

# ---------- 上传 ----------
UPLOAD_DIR=../../runtime/uploads
UPLOAD_MAX_BYTES=209715200
MEDIA_URL_TTL=3600

# ---------- TURN / STUN ----------
TURN_URLS=turn:chat.lkz.pub:3478?transport=udp,turn:chat.lkz.pub:3478?transport=tcp,turns:chat.lkz.pub:5349?transport=tcp
TURN_STATIC_AUTH_SECRET=
TURN_CREDENTIAL_TTL=86400
STUN_URLS=stun:chat.lkz.pub:3478

# ---------- 通话 ----------
CALL_RING_TIMEOUT_MS=45000
CALL_MESH_MAX=8
CALL_VIDEO_ENABLED=false

# ---------- SFU ----------
SFU_ENABLED=false

# ---------- 注册与邀请 ----------
REGISTER_REQUIRE_INVITE=true
DEFAULT_INVITE_QUOTA=5

# ---------- 推送 ----------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=pub.lkz.chat
APNS_PRODUCTION=true

HMS_APP_ID=
HMS_APP_SECRET=

XIAOMI_APP_SECRET=
XIAOMI_PACKAGE=pub.lkz.chat

OPPO_APP_KEY=
OPPO_MASTER_SECRET=

VIVO_APP_ID=
VIVO_APP_KEY=
VIVO_APP_SECRET=

HARMONY_PUSH_APP_ID=
HARMONY_PUSH_APP_SECRET=

# ---------- 日志 ----------
LOG_LEVEL=debug
LOG_PRETTY=true
