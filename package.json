{
  "name": "chat",
  "version": "2.0.0",
  "private": true,
  "description": "chat - 跨端即时通讯（Lynx + TypeScript）",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @chat/server db:generate",
    "db:migrate": "pnpm --filter @chat/server db:migrate",
    "db:push": "pnpm --filter @chat/server db:push"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
